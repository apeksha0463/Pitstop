# Pitstop — SerpApi configuration template
# 1. Copy this file to sources/.env   (PowerShell: Copy-Item scripts/.env.example sources/.env)
# 2. Replace the placeholder with your key from https://serpapi.com/manage-api-key
# sources/.env is git-ignored; never put a real key in this example file.
SERPAPI_API_KEY=PASTE_YOUR_NEW_KEY_HERE

# Supabase (upload_to_supabase.py and site/config.js)
# URL and publishable key are public and read-only (Row Level Security).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_PASTE_YOURS_HERE
# Private: only for scripts/upload_to_supabase.py. Never put these in site/.
SUPABASE_SECRET_KEY=PASTE_YOUR_SECRET_KEY_HERE
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
