# scripts/.gitignore
# Protect configuration secrets, bytecode, and test caches

# Secrets & environment
.env
*.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Partial / temporary downloads
*.part
*.tmp
