# =============================================================================
# .gitignore — Google Maps Review Extractor
# =============================================================================

# ------- Credentials — NEVER commit --------
.env

# ------- Python --------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ------- Virtual environments --------
.venv/
venv/
ENV/
env/

# ------- Test / coverage caches --------
.pytest_cache/
.coverage
htmlcov/
*.xml

# ------- Data folders (generated / scraped data) --------
# Keep the folder skeleton (.gitkeep) but exclude actual data files.
data/raw_data/*.json
data/extracted_pages/*.json
data/extracted_images/*
!data/extracted_images/.gitkeep
data/processed/*.json

# ------- Output (final review JSON datasets) --------
# Individual datasets are excluded by default.
# To intentionally track a dataset, force-add it:
#   git add -f output/my_restaurant.json
output/*.json
!output/.gitkeep

# ------- IDE --------
.vscode/
.idea/
*.swp
*.swo

# ------- OS --------
.DS_Store
Thumbs.db

# ------- Logs / temps --------
*.log
*.tmp
